import("//build_overrides/chip.gni")
static_library("camera-sdk") {
  output_name = "G2HCameraSDK"
  output_dir = "${root_out_dir}/lib"
  complete_static_lib = true
  sources = [
    "${chip_root}/examples/all-clusters-app/all-clusters-common/src/tls-certificate-management-instance.cpp",
    "${chip_root}/examples/all-clusters-app/all-clusters-common/src/tls-client-management-instance.cpp",
  ]
  include_dirs = [ "${chip_root}/examples/all-clusters-app/all-clusters-common/include" ]
  public_deps = [
    "${chip_root}/examples/platform/linux:app-main",
    "${chip_root}/src/app/clusters/tls-certificate-management-server:certificate-table",
    "${chip_root}/src/app/clusters/tls-client-management-server",

    "${chip_root}/src/lib",
    "//model",
    "${chip_root}/src/app/clusters/camera-av-stream-management-server",
    "${chip_root}/src/app/clusters/webrtc-transport-provider-server",
  ]
}
group("default") { deps = [ ":camera-sdk" ] }
